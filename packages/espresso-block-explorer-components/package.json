  },
  "files": [
    "/dist"
  ],
  "keywords": [],
  "license": "ISC",
  "main": "dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/espresso-block-explorer-components.es.js",
      "types": "./dist/src/espresso-block-explorer-components.d.ts"
    },
    "./block-explorer": {
      "import": "./dist/block-explorer.es.js",
      "types": "./dist/src/block-explorer.d.ts"
    },
    "./delegation-ui": {
      "import": "./dist/delegation-ui.es.js",
      "types": "./dist/src/delegation-ui.d.ts"
    },
    "./espresso-block-explorer-components.css": "./dist/espresso-block-explorer-components.css",
    "./block-explorer.css": "./dist/block-explorer.css",
    "./delegation-ui.css": "./dist/delegation-ui.css"
  },
  "name": "espresso-block-explorer-components",
  "peerDependencies": {
    "@rainbow-me/rainbowkit": "^2.2.5",
    "@tanstack/react-query": "^5.80.2",
    "react": "^19",
    "viem": "^2.30.6",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "react-lottie": "npm:@amelix/react-lottie@^1.2.4"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "vite build && npm run copy-assets",
    "copy-assets": "npm run copy-assets:block-explorer && npm run copy-assets:delegation-ui",
    "copy-assets:block-explorer": "mkdir -p ../block-explorer/public/assets && cp dist/assets/*worker*.js ../block-explorer/public/assets/.",
    "copy-assets:delegation-ui": "mkdir -p ../delegation-ui/public/assets && cp dist/assets/*worker*.js ../delegation-ui/public/assets/.",
    "build-storybook": "storybook build",
    "coverage": "vitest run --coverage",
    "format": "prettier --write --parser typescript '**/*.{ts,tsx}'",
    "lint": "eslint src --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test-storybook": "test-storybook",
    "test-watch": "vitest",
    "test:ui": "vitest --ui",
    "regenerate-baked-map-data": "GENERATE=1 vitest run src/models/geo/world_map_grid/__test__/generate_grid.test.ts"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "version": "0.1.0"
}
