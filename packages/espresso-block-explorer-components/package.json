    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^6",
    "eslint-plugin-storybook": "^10",
    "ethereum-blockies-base64": "^1",
    "globals": "^16",
    "jsdom": "^27",
