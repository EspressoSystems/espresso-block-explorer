    "react-dom": "^19",
    "react-lottie": "^1",
    "storybook": "^10",
    "typescript": "^5",
    "viem": "^2",
    "vite": "^7",
    "vite-plugin-circular-dependency": "^0.5",
    "vite-plugin-dts": "^4",
